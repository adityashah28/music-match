# Copy this file to .env.local and fill in real values. Never commit .env.local.
# None of these get the NEXT_PUBLIC_ prefix: they must stay on the server.

# Supabase → Project Settings → API Keys / Data API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Apify → Settings → Integrations
APIFY_TOKEN=
# Any random string; also set it on the Apify webhook
APIFY_WEBHOOK_SECRET=

# developer.ticketmaster.com → My Apps → Consumer Key
TICKETMASTER_KEY=
