# Public Supabase project URL. Safe to expose in the browser.
# Required for Google OAuth (UI calls startGoogleSignIn → Supabase signInWithOAuth).
NEXT_PUBLIC_SUPABASE_URL=

# Anon key for browser auth (Google OAuth). Table access still uses the service role on the server.
# Enable Google under Supabase Auth → Providers, and add redirect URL: {origin}/auth/callback
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Full database access. Never send this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Spotify app credentials. Client-credentials search, no user login.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Server-only Apify token and the shared secret for the webhook route.
APIFY_TOKEN=
APIFY_WEBHOOK_SECRET=

# Server-only. Used by the shows seed (npm run seed:shows).
TICKETMASTER_KEY=

# Server-only. Same value as NEXT_PUBLIC_SUPABASE_URL; the seed scripts accept either.
# SUPABASE_URL=

# Phone login uses Supabase Auth. Turn on the Phone provider and pick an SMS provider
# (e.g. Twilio Verify) in the Supabase dashboard: no SMS keys live in this app.
# For demos, add test numbers with fixed codes under Auth > Providers > Phone.
